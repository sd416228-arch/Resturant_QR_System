# --- Frontend ---
# The URL your QR codes point to. It MUST be reachable from the scanning phone
# and MUST be https:// in production, because Chrome's HTTPS-First mode refuses
# to load a plain-http page (it auto-upgrades to https and the handshake fails
# with "This site can't provide a secure connection").
#
# Local development on your LAN (phone and computer on the same Wi-Fi):
#   VITE_PUBLIC_URL=http://192.168.1.2:5173
#
# Production behind a domain with a real certificate (recommended, and the only
# warning-free option for printed table placards):
#   VITE_PUBLIC_URL=https://order.your-restaurant.com
VITE_PUBLIC_URL=http://YOUR-COMPUTER-IP:5173

# Optional: full API base URL. Leave unset and it is derived from the page.
# Same-origin when the app is served by server.mjs (npm run serve).
# VITE_API_URL=

# Optional: override the API port the frontend calls (default 8787).
# VITE_API_PORT=8787

# Owner/admin bearer token the admin UI sends on write endpoints (menu edits,
# QR token issuance). Must match ADMIN_TOKEN on the server. Leave empty in dev.
VITE_ADMIN_TOKEN=

# --- Backend (server.mjs) ---
# Port the Order API listens on (default 8787). In single-origin mode this also
# serves the built frontend from dist/, so it is the one public URL.
# API_PORT=8787
# API_HOST=0.0.0.0

# CORS origin allowed to call the API. Leave unset for wildcard during development.
# Not needed in single-origin mode, where the app and API share an origin.
# Set to your frontend origin in production, e.g. https://your-app.example.com
ALLOWED_ORIGIN=

# Secret used to sign QR table tokens. MUST be a long random value in production.
# Without it, the server falls back to a dev-only default and prints a warning.
QR_TOKEN_SECRET=change-me-to-a-long-random-string

# Owner bearer secret for PUT /api/menu and POST /api/tables/token. MUST be a long
# random value in production; the frontend must send the same value via
# VITE_ADMIN_TOKEN. Without it the protected endpoints stay open (dev mode).
ADMIN_TOKEN=change-me-to-another-long-random-string

# Restaurant identifier bound into QR tokens (default moss-ember).
# RESTAURANT_ID=moss-ember

# --- PostgreSQL ---
# PostgreSQL connection string for the backend database.
# Example: postgresql://postgres:postgres@localhost:5432/restaurant_qr
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant_qr